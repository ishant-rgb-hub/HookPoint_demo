# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Shared HMAC-SHA256 Signing Secret
# (Must match secret used by sending services)
WEBHOOK_SECRET=whsec_evaluation_test_secret_2026

# Replay Attack Tolerance Window (in seconds)
# Incoming webhooks older than this tolerance are rejected (default: 300s = 5 min)
REPLAY_TOLERANCE_SECONDS=300

# Replay Cache Protection
# Prevents reprocessing webhooks with duplicate x-webhook-id headers
REPLAY_PROTECTION=true

# Retention duration for seen webhook IDs in milliseconds (default: 10 min)
REPLAY_TTL_MS=600000

# Header containing the HMAC signature (default: x-webhook-signature)
SIGNATURE_HEADER_NAME=x-webhook-signature
